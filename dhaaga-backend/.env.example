# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/dhaaga

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI services (used by /api/ai routes)
# Anthropic (Claude) - used for multilingual structuring, translation,
# and craft-image classification/verification (Claude vision)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI - used ONLY for Whisper speech-to-text (Claude does not accept
# raw audio input, so voice interviews are transcribed with Whisper first,
# then structured/translated with Claude)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# File storage
# "local" stores files on disk under /uploads (fine for dev/demo).
# Swap to "s3" in utils/upload.js when you're ready for production.
STORAGE_DRIVER=local
